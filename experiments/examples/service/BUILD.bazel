    requirement("google-cloud-aiplatform"),
    requirement("fastapi"),
    requirement("uvicorn"),
]

py_binary(
    name = "run",
    srcs = [
        "auth.py",
        "main.py",
        "run.py",
        "models/__init__.py",
        "models/checks_model.py",
        "models/common_model.py",
        "routers/__init__.py",
        "routers/categories.py",
        "routers/checks.py",
